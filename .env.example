# Environment for the calls pipeline on the training box. Copy, fill in, load:
#
#   cp .env.example .env && chmod 600 .env    # .env is git-ignored: it holds secrets
#   source .env                               # in every new shell / tmux window
#
# Then `scripts/fetch_inputs.sh` checks HF and MLflow before anything long runs.

# --- MLflow (required: every stage refuses to run without a tracking URI) ---
export MLFLOW_TRACKING_URI="https://mlflow.example.com"
# Auth: username + password (Basic) OR a token (Bearer), not both. Leave the
# other pair commented out.
export MLFLOW_TRACKING_USERNAME=""
export MLFLOW_TRACKING_PASSWORD=""
# export MLFLOW_TRACKING_TOKEN=""

# --- Hugging Face ---
# Needs read on kapturecx/bolAIndia and write on kapturecx/nemotron-3.5-fine-tune
# (checkpoints, winner.nemo). Leave commented out to use `uv run hf auth login`.
# export HF_TOKEN=""
# Faster whole-file downloads in `convert`.
export HF_XET_HIGH_PERFORMANCE=1
# HF's cache (~10 GB of download chunks during convert, the LaBSE model for
# semdist) defaults to ~/.cache/huggingface. If the home disk is small, move it
# next to the data. A token saved by `hf auth login` lives here too: log in
# again after changing it, or set HF_TOKEN.
# export HF_HOME="/data-g/uday/.cache/huggingface"

# --- Temp files ---
# Checkpoints (~8 GB) pass through the temp dir on save, and a .nemo is unpacked
# into it. If /tmp is small, point it at the big disk (train/benchmark default to
# <run_root>/tmp when this is unset).
# export TMPDIR="/data-g/uday/tmp"

# --- Google Chat progress messages (optional; unset = none sent) ---
# A space's incoming webhook URL: anyone holding it can post there.
# export GCHAT_WEBHOOK_URL=""
